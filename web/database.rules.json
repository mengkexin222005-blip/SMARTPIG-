{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'user')",
      "$uid": {
        ".write": "auth != null && auth.uid !== 'vP6dpAwKIPexvhLpD584qgD23Og1' && $uid !== 'vP6dpAwKIPexvhLpD584qgD23Og1' && (auth.uid === $uid || root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'user')",
        ".validate": "newData.hasChildren(['email', 'role'])",
        "name": {
          ".validate": "newData.isString() && newData.val().length <= 80"
        },
        "email": {
          ".validate": "newData.isString() && newData.val().length <= 120"
        },
        "createdAt": {
          ".validate": "newData.isNumber()"
        },
        "lastSignInAt": {
          ".validate": "newData.isNumber()"
        },
        "lastSeenAt": {
          ".validate": "newData.isNumber()"
        },
        "signInCount": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "lastDevice": {
          ".validate": "newData.isString() && newData.val().length <= 60"
        },
        "role": {
          ".validate": "newData.isString() && newData.val().matches(/^(admin|user|pending|disabled)$/) && (newData.val() === data.val() || (!data.exists() && newData.val() === 'user') || (auth.uid === $uid && data.val() === 'pending' && newData.val() === 'user') || (auth.uid !== $uid && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'user') && (newData.val() === 'user' || newData.val() === 'disabled')))"
        },
        "$other": {
          ".validate": false
        },
        ".read": "auth != null && auth.uid === $uid"
      }
    },
    "smartpig": {
      ".read": true,
      ".write": "auth != null && auth.uid === 'vP6dpAwKIPexvhLpD584qgD23Og1'",
      ".validate": "newData.hasChildren(['lastUpdated', 'sensorOk', 'waterLevel'])",
      "temperature": {
        ".validate": "newData.isNumber() && newData.val() >= -40 && newData.val() <= 125"
      },
      "humidity": {
        ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100"
      },
      "sensorOk": {
        ".validate": "newData.isBoolean()"
      },
      "waterLevel": {
        ".validate": "newData.isString() && (newData.val() === 'FULL' || newData.val() === 'HALF FULL' || newData.val() === 'ALMOST LOW' || newData.val() === 'BELOW LOW')"
      },
      "waterTop": {
        ".validate": "newData.isBoolean()"
      },
      "waterMiddle": {
        ".validate": "newData.isBoolean()"
      },
      "waterBottom": {
        ".validate": "newData.isBoolean()"
      },
      "rtcValid": {
        ".validate": "newData.isBoolean()"
      },
      "rtcDate": {
        ".validate": "newData.isString() && newData.val().length <= 10"
      },
      "rtcTime": {
        ".validate": "newData.isString() && newData.val().length <= 8"
      },
      "lastUpdated": {
        ".validate": "newData.val() === now"
      },
      "seq": {
        ".validate": "newData.isNumber()"
      },
      "sentAt": {
        ".validate": "newData.isNumber()"
      },
      "uptimeSec": {
        ".validate": "newData.isNumber()"
      },
      "bootCount": {
        ".validate": "newData.isNumber()"
      },
      "freeHeap": {
        ".validate": "newData.isNumber()"
      },
      "resetReason": {
        ".validate": "newData.isString() && newData.val().length <= 32"
      },
      "hopperGrams": {
        ".validate": "newData.isNumber() && newData.val() >= -1000 && newData.val() <= 100000"
      },
      "trayGrams": {
        ".validate": "newData.isNumber() && newData.val() >= -1000 && newData.val() <= 100000"
      },
      "ageDays": {
        ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 400"
      },
      "pigs": {
        ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 3"
      },
      "adjustPct": {
        ".validate": "newData.isNumber() && newData.val() >= -50 && newData.val() <= 50"
      },
      "state": {
        ".validate": "newData.isString() && newData.val().length <= 12"
      },
      "$other": {
        ".validate": false
      }
    },
    "smartpigHistory": {
      ".read": true,
      ".indexOn": [
        "recordedAt"
      ],
      "$recordId": {
        ".write": "auth != null && auth.uid === 'vP6dpAwKIPexvhLpD584qgD23Og1' && !data.exists()",
        ".validate": "newData.hasChildren(['recordedAt', 'deviceId', 'schemaVersion', 'sensorOk', 'waterLevel'])",
        "recordedAt": {
          ".validate": "newData.val() === now"
        },
        "deviceId": {
          ".validate": "newData.isString() && newData.val().length <= 32"
        },
        "schemaVersion": {
          ".validate": "newData.isNumber()"
        },
        "temperature": {
          ".validate": "newData.isNumber() && newData.val() >= -40 && newData.val() <= 125"
        },
        "humidity": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100"
        },
        "sensorOk": {
          ".validate": "newData.isBoolean()"
        },
        "waterLevel": {
          ".validate": "newData.isString() && (newData.val() === 'FULL' || newData.val() === 'HALF FULL' || newData.val() === 'ALMOST LOW' || newData.val() === 'BELOW LOW')"
        },
        "waterTop": {
          ".validate": "newData.isBoolean()"
        },
        "waterMiddle": {
          ".validate": "newData.isBoolean()"
        },
        "waterBottom": {
          ".validate": "newData.isBoolean()"
        },
        "rtcValid": {
          ".validate": "newData.isBoolean()"
        },
        "rtcDate": {
          ".validate": "newData.isString() && newData.val().length <= 10"
        },
        "rtcTime": {
          ".validate": "newData.isString() && newData.val().length <= 8"
        },
        "seq": {
          ".validate": "newData.isNumber()"
        },
        "sentAt": {
          ".validate": "newData.isNumber()"
        },
        "uptimeSec": {
          ".validate": "newData.isNumber()"
        },
        "bootCount": {
          ".validate": "newData.isNumber()"
        },
        "freeHeap": {
          ".validate": "newData.isNumber()"
        },
        "resetReason": {
          ".validate": "newData.isString() && newData.val().length <= 32"
        },
        "hopperGrams": {
          ".validate": "newData.isNumber() && newData.val() >= -1000 && newData.val() <= 100000"
        },
        "trayGrams": {
          ".validate": "newData.isNumber() && newData.val() >= -1000 && newData.val() <= 100000"
        },
        "ageDays": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 400"
        },
        "pigs": {
          ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 3"
        },
        "adjustPct": {
          ".validate": "newData.isNumber() && newData.val() >= -50 && newData.val() <= 50"
        },
        "state": {
          ".validate": "newData.isString() && newData.val().length <= 12"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "smartpigConfig": {
      ".read": true,
      "schedule": {
        ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'user')",
        "$slot": {
          ".validate": "($slot === 'am' || $slot === 'pm') && newData.hasChildren(['time', 'enabled']) && (($slot === 'am' && newData.child('time').val() < '12:00') || ($slot === 'pm' && newData.child('time').val() >= '12:00'))",
          "time": {
            ".validate": "newData.isString() && newData.val().matches(/^([01][0-9]|2[0-3]):[0-5][0-9]$/)"
          },
          "enabled": {
            ".validate": "newData.isBoolean()"
          },
          "$other": {
            ".validate": false
          }
        }
      },
      "settings": {
        "pigType": {
          ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'user')",
          ".validate": "newData.isString() && newData.val().matches(/^(weaner|grower|finisher)$/)"
        },
        "pigCount": {
          ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'user')",
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000"
        },
        "avgWeightKg": {
          ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'user')",
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 400"
        },
        "feedPct": {
          ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'user')",
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10"
        },
        "aiEnabled": {
          ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'user')",
          ".validate": "newData.isBoolean()"
        },
        "$num": {
          ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'user')",
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000"
        }
      },
      "updatedAt": {
        ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'user')",
        ".validate": "newData.isNumber()"
      },
      "deviceAck": {
        ".write": "auth != null && auth.uid === 'vP6dpAwKIPexvhLpD584qgD23Og1'",
        ".validate": "newData.isNumber()"
      },
      "$other": {
        ".validate": false
      },
      "pen": {
        ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'user') && (!data.exists() || !newData.exists())",
        ".validate": "newData.hasChildren(['count', 'ageDays', 'registeredAt', 'registeredDate'])",
        "count": {
          ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 3 && newData.val() % 1 === 0"
        },
        "ageDays": {
          ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 180 && newData.val() % 1 === 0"
        },
        "registeredAt": {
          ".validate": "newData.isNumber()"
        },
        "registeredDate": {
          ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)"
        },
        "by": {
          ".validate": "newData.isString() && newData.val().length <= 128"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "smartpigBatches": {
      ".read": true,
      ".indexOn": [
        "finishedAt"
      ],
      "$id": {
        ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'user') && !data.exists()",
        ".validate": "newData.hasChildren(['count', 'ageDays', 'registeredDate', 'ageAtFinish', 'finishedAt'])",
        "count": {
          ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 3"
        },
        "ageDays": {
          ".validate": "newData.isNumber()"
        },
        "registeredAt": {
          ".validate": "newData.isNumber()"
        },
        "registeredDate": {
          ".validate": "newData.isString() && newData.val().length <= 10"
        },
        "ageAtFinish": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 2000"
        },
        "finishedAt": {
          ".validate": "newData.isNumber()"
        },
        "finishedDate": {
          ".validate": "newData.isString() && newData.val().length <= 10"
        },
        "by": {
          ".validate": "newData.isString() && newData.val().length <= 128"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "smartpigCommands": {
      ".read": true,
      "feedNow": {
        ".write": "auth != null && ((auth.uid === 'vP6dpAwKIPexvhLpD584qgD23Og1' && newData.child('status').val().matches(/^(running|done|failed)$/)) || ((root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'user') && newData.child('status').val().matches(/^(pending|cancelled)$/)))",
        ".validate": "newData.hasChildren(['id', 'grams', 'status', 'requestedAt'])",
        "id": {
          ".validate": "newData.isString() && newData.val().length <= 40"
        },
        "grams": {
          ".validate": "newData.isNumber() && newData.val() >= 10 && newData.val() <= 50000 && (!root.child('smartpigConfig/settings/maxGramsPerFeed').exists() || newData.val() <= root.child('smartpigConfig/settings/maxGramsPerFeed').val())"
        },
        "by": {
          ".validate": "newData.isString() && newData.val().length <= 128"
        },
        "requestedAt": {
          ".validate": "newData.isNumber()"
        },
        "status": {
          ".validate": "newData.isString()"
        },
        "dispensedGrams": {
          ".validate": "newData.isNumber()"
        },
        "startedAt": {
          ".validate": "newData.isNumber()"
        },
        "finishedAt": {
          ".validate": "newData.isNumber()"
        },
        "error": {
          ".validate": "newData.isString() && newData.val().length <= 120"
        },
        "$other": {
          ".validate": false
        }
      },
      "$other": {
        ".validate": false
      }
    },
    "smartpigFeedLog": {
      ".read": true,
      ".indexOn": [
        "startedAt"
      ],
      "$id": {
        ".write": "auth != null && auth.uid === 'vP6dpAwKIPexvhLpD584qgD23Og1'",
        ".validate": "newData.hasChildren(['source', 'startedAt', 'targetGrams'])",
        "source": {
          ".validate": "newData.isString() && newData.val().matches(/^(schedule|manual)$/)"
        },
        "slot": {
          ".validate": "newData.isString() && newData.val().length <= 40"
        },
        "commandId": {
          ".validate": "newData.isString() && newData.val().length <= 40"
        },
        "scheduledTime": {
          ".validate": "newData.isString() && newData.val().length <= 5"
        },
        "rtcStart": {
          ".validate": "newData.isString() && newData.val().length <= 8"
        },
        "startedAt": {
          ".validate": "newData.isNumber()"
        },
        "finishedAt": {
          ".validate": "newData.isNumber()"
        },
        "targetGrams": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 50000"
        },
        "dispensedGrams": {
          ".validate": "newData.isNumber() && newData.val() >= -100 && newData.val() <= 60000"
        },
        "leftoverGrams": {
          ".validate": "newData.isNumber() && newData.val() >= -100 && newData.val() <= 60000"
        },
        "nextGrams": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 50000"
        },
        "durationMs": {
          ".validate": "newData.isNumber()"
        },
        "method": {
          ".validate": "newData.isString() && newData.val().length <= 16"
        },
        "ok": {
          ".validate": "newData.isBoolean()"
        },
        "error": {
          ".validate": "newData.isString() && newData.val().length <= 120"
        },
        "scaleGrams": {
          ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'user')",
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 60000"
        },
        "mealTargetGrams": {
          ".validate": "newData.isNumber() && newData.val() >= -100 && newData.val() <= 60000"
        },
        "trayBeforeGrams": {
          ".validate": "newData.isNumber() && newData.val() >= -100 && newData.val() <= 60000"
        },
        "trayAfterGrams": {
          ".validate": "newData.isNumber() && newData.val() >= -100 && newData.val() <= 60000"
        },
        "aiGrams": {
          ".validate": "newData.isNumber() && newData.val() >= -100 && newData.val() <= 60000"
        },
        "formulaGrams": {
          ".validate": "newData.isNumber() && newData.val() >= -100 && newData.val() <= 60000"
        },
        "decidedBy": {
          ".validate": "newData.isString() && newData.val().matches(/^(ai|formula)$/)"
        },
        "adjustPct": {
          ".validate": "newData.isNumber() && newData.val() >= -50 && newData.val() <= 50"
        },
        "trend": {
          ".validate": "newData.isString() && newData.val().length <= 12"
        },
        "ageDays": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 400"
        },
        "pigs": {
          ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 3"
        },
        "emptyMeals": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10"
        },
        "leftoverMeals": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10"
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
